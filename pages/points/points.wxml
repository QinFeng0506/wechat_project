<!-- 积分中心 — 签到、余额、规则 -->
<view class="page">
  <!-- 积分余额卡片 -->
  <view class="balance-card">
    <view class="balance-circle">
      <text class="balance-num">{{pointsBalance}}</text>
      <text class="balance-label">当前积分</text>
    </view>
    <view class="balance-hint" wx:if="{{expiringPoints > 0}}">
      <text>⚠️ {{expiringPoints}}积分即将过期</text>
    </view>
  </view>

  <!-- 签到区 -->
  <view class="sign-section card">
    <view class="sign-header flex-between">
      <text class="sign-title">📅 每日签到</text>
      <text class="text-xs text-secondary">连续签到 {{signStreak}} 天</text>
    </view>
    <!-- 签到日历周 -->
    <view class="sign-week">
      <view class="sign-day {{item.signed ? 'signed' : ''}} {{item.isToday ? 'today' : ''}}"
            wx:for="{{signWeek}}" wx:key="day">
        <text class="sign-day-name">{{item.dayName}}</text>
        <view class="sign-dot {{item.signed ? 'signed-dot' : ''}}">
          <text wx:if="{{item.signed}}">✓</text>
          <text wx:else>{{item.bonus}}</text>
        </view>
      </view>
    </view>
    <view class="btn-primary sign-btn {{todaySigned ? 'btn-disabled' : ''}}" bindtap="onCheckIn">
      <text>{{todaySigned ? '今日已签到 ✓' : '签到领积分 +5'}}</text>
    </view>
  </view>

  <!-- 积分规则 -->
  <view class="rules-section card">
    <text class="section-label">📋 积分规则</text>
    <view class="rule-item flex-between">
      <text>每日签到</text><text class="text-primary-color">+5 积分</text>
    </view>
    <view class="rule-item flex-between">
      <text>连续签到7天</text><text class="text-primary-color">额外 +15 积分</text>
    </view>
    <view class="rule-item flex-between">
      <text>消费赠送</text><text class="text-primary-color">1元 = 1积分</text>
    </view>
    <view class="rule-item flex-between">
      <text>新用户注册</text><text class="text-primary-color">+50 积分</text>
    </view>
    <view class="rule-item flex-between">
      <text>积分有效期</text><text>12个月</text>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-actions">
    <view class="action-btn btn-primary" bindtap="onGoMall">
      <text>🎁 积分商城</text>
    </view>
    <view class="action-btn btn-outline" bindtap="onGoHistory">
      <text>📊 积分明细</text>
    </view>
  </view>
</view>
