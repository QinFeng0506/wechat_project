/**
 * 个人中心页样式
 */

.page {
  min-height: 100vh;
}

/* ===== 用户头部 ===== */
.user-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xl) 0 var(--spacing-lg);
  background: linear-gradient(180deg, #FBF1F1 0%, var(--bg-white) 100%);
}

.user-avatar-wrap {
  position: relative;
  margin-bottom: var(--spacing-sm);
}

.user-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-round);
  border: 4rpx solid var(--primary-light);
  background: var(--bg-muted);
}

.avatar-badge {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  background: var(--primary);
  color: var(--text-white);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-lg);
}

.user-name {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

/* ===== 数据概览 ===== */
.stats-row {
  display: flex;
  margin: -24rpx var(--spacing-md) var(--spacing-md);
  background: var(--bg-white);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  position: relative;
  z-index: 2;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-md);
}

.stat-num {
  font-size: var(--font-xxl);
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: var(--font-xs);
  color: var(--text-secondary);
}

/* ===== 功能菜单 ===== */
.menu-section {
  margin: 0 var(--spacing-md);
  background: var(--bg-white);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-md);
  border-bottom: 1rpx solid var(--border);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: var(--font-lg);
  margin-right: var(--spacing-sm);
}

.menu-text {
  flex: 1;
  font-size: var(--font-md);
  color: var(--text-primary);
}

.menu-badge {
  background: #E07B7B;
  color: var(--text-white);
  font-size: var(--font-xs);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-lg);
  margin-right: var(--spacing-sm);
}

.menu-arrow {
  font-size: var(--font-lg);
  color: var(--text-muted);
}

/* 管理后台入口 */
.admin-entry { border-top: 2rpx solid var(--primary-light); margin-top: var(--spacing-sm); }
.admin-entry .menu-text { color: var(--primary); font-weight: 500; }

/* ===== 版本信息 ===== */
.version-info {
  text-align: center;
  padding: var(--spacing-xl) 0;
}

/* ===== 底部声明 ===== */
.disclaimer {
  padding: 0 var(--spacing-xl) var(--spacing-xl);
  text-align: center;
  line-height: 1.8;
}
