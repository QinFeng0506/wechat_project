/**
 * 首页样式 — Ins风温柔简约
 */

.page {
  padding-bottom: 20rpx;
}

/* ===== Banner ===== */
.banner {
  width: 100%;
  height: 360rpx;
}

.banner-image {
  width: 100%;
  height: 360rpx;
}

.banner-title {
  position: absolute;
  bottom: 40rpx;
  left: 32rpx;
  color: #fff;
  font-size: var(--font-xl);
  font-weight: 600;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

/* ===== 公告栏 ===== */
.notice-bar {
  margin: var(--spacing-sm) var(--spacing-md);
  padding: var(--spacing-sm) var(--spacing-md);
  background: linear-gradient(135deg, #FFF8F0, #FFF0E8);
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(212, 160, 160, 0.15);
}

.notice-icon {
  font-size: var(--font-md);
  margin-right: var(--spacing-sm);
  flex-shrink: 0;
}

.notice-scroll-wrap {
  flex: 1;
  overflow: hidden;
}

.notice-text {
  font-size: var(--font-sm);
  color: var(--text-primary);
  white-space: nowrap;
  animation: notice-scroll 12s linear infinite;
}

@keyframes notice-scroll {
  0%   { transform: translateX(100%); }
  100% { transform: translateX(-100%); }
}

.notice-arrow {
  font-size: var(--font-lg);
  color: var(--text-muted);
  flex-shrink: 0;
  margin-left: var(--spacing-xs);
}

/* ===== 分类入口 ===== */
.category-section {
  background: var(--bg-white);
  margin: -24rpx 24rpx 0;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: var(--spacing-md) 0;
  position: relative;
  z-index: 2;
}

.category-list {
  display: flex;
  justify-content: space-around;
  padding: 0 var(--spacing-sm);
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xs);
}

.category-icon {
  width: 96rpx;
  height: 96rpx;
  background: var(--bg-muted);
  border-radius: var(--radius-round);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-bottom: var(--spacing-xs);
}

.category-name {
  font-size: var(--font-sm);
  color: var(--text-primary);
}

/* ===== 区块标题 ===== */
.section {
  margin-top: var(--spacing-lg);
  padding: 0 var(--spacing-md);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-sm);
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
  display: flex;
  align-items: center;
}

.title-icon {
  margin-right: var(--spacing-xs);
  font-size: var(--font-lg);
}

.section-more {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

/* ===== 热门横向滚动 ===== */
.hot-scroll {
  white-space: nowrap;
  width: 100%;
}

.hot-card {
  display: inline-block;
  width: 280rpx;
  margin-right: var(--spacing-sm);
  border-radius: var(--radius-md);
  background: var(--bg-white);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  position: relative;
  white-space: normal;
}

.hot-card:last-child {
  margin-right: 0;
}

.hot-image {
  width: 280rpx;
  height: 340rpx;
}

.hot-info {
  padding: var(--spacing-sm);
}

.hot-name {
  font-size: var(--font-sm);
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.hot-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hot-tag {
  position: absolute;
  top: var(--spacing-sm);
  left: var(--spacing-sm);
}

/* ===== 新品网格 ===== */
.new-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.new-card {
  width: calc(50% - 8rpx);
  background: var(--bg-white);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.new-image {
  width: 100%;
  height: 320rpx;
}

.new-info {
  padding: var(--spacing-sm);
}

.new-name {
  font-size: var(--font-sm);
  color: var(--text-primary);
  margin-bottom: 6rpx;
  display: block;
}

.new-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.new-tag {
  padding: 2rpx 12rpx;
}

/* ===== 活动卡片 ===== */
.activity-card {
  margin-bottom: var(--spacing-sm);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.activity-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.activity-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.activity-desc {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  line-height: 1.5;
}

.activity-tag {
  margin-left: var(--spacing-sm);
  flex-shrink: 0;
}
