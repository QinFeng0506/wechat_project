.page{padding-bottom:40rpx}
.diy-banner{width:100%;height:320rpx;position:relative}
.banner-img{width:100%;height:320rpx}
.banner-label{position:absolute;bottom:20rpx;left:24rpx;color:#fff;font-size:var(--font-md);font-weight:600;text-shadow:0 2rpx 8rpx rgba(0,0,0,.3)}
.diy-start{flex-direction:column;margin:var(--spacing-md);padding:var(--spacing-xl) 0;cursor:pointer}
.start-icon{font-size:80rpx;margin-bottom:var(--spacing-sm)}
.start-text{font-size:var(--font-lg);font-weight:600;color:var(--text-primary);margin-bottom:6rpx}
.section-title{font-size:var(--font-md);font-weight:600;display:block;margin-bottom:var(--spacing-sm)}
.template-scroll{white-space:nowrap}
.template-card{display:inline-block;margin-right:var(--spacing-sm);width:140rpx;text-align:center}
.tp-preview{width:120rpx;height:120rpx;border-radius:var(--radius-round);margin:0 auto 8rpx;position:relative;overflow:hidden}
.tp-tip{position:absolute;top:0;left:0;right:0;height:24rpx}
.tp-name{color:var(--text-secondary)}
.work-thumb{width:160rpx;height:200rpx;border-radius:var(--radius-md);margin-right:var(--spacing-sm)}
