<!-- 积分商品编辑页 — 新增/编辑表单 + 图片上传 -->
<view class="page container">

  <!-- 图片选择 -->
  <view class="image-section">
    <view class="image-picker" bindtap="onChooseImage">
      <image wx:if="{{image}}" class="cover-preview" src="{{image}}" mode="aspectFill" />
      <view wx:else class="image-placeholder">
        <text class="placeholder-icon">📷</text>
        <text class="text-xs text-muted">点击选择商品图片</text>
      </view>
      <view class="image-loading" wx:if="{{uploading}}">
        <text class="text-xs">图片处理中...</text>
      </view>
    </view>
    <text class="text-xs text-muted">点击图片从手机相册选择，自动压缩存储</text>
  </view>

  <!-- 基本信息 -->
  <view class="card form-card">
    <view class="form-row">
      <text class="form-label">商品名称</text>
      <input class="form-input" placeholder="如：纯色美甲体验" value="{{name}}" bindinput="onNameInput" maxlength="20" />
    </view>
    <view class="form-row">
      <text class="form-label">商品类型</text>
      <picker class="form-picker" range="{{typeLabels}}" value="{{typeIndex}}" bindchange="onPickType">
        <view class="picker-value">
          <text>{{typeLabels[typeIndex]}}</text>
          <text class="picker-arrow">▾</text>
        </view>
      </picker>
    </view>
    <view class="form-row">
      <text class="form-label">所需积分</text>
      <input class="form-input" type="number" placeholder="如：200" value="{{points}}" bindinput="onPointsInput" />
    </view>
    <view class="form-row">
      <text class="form-label">参考价格（元）</text>
      <input class="form-input" type="number" placeholder="如：128" value="{{originalPrice}}" bindinput="onPriceInput" />
    </view>
    <view class="form-row">
      <text class="form-label">库存数量</text>
      <input class="form-input" type="number" placeholder="留空表示不限量" value="{{stock}}" bindinput="onStockInput" />
    </view>
    <view class="form-row form-col no-border">
      <text class="form-label">商品说明</text>
      <textarea class="form-textarea" placeholder="如：可兑换纯色美甲一次 / 满200元可用" value="{{description}}" bindinput="onDescInput" maxlength="100" />
      <text class="text-xs text-muted text-right">{{description.length}}/100</text>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-actions safe-bottom">
    <view class="btn-outline" bindtap="onCancel"><text>取消</text></view>
    <view class="btn-primary flex-1" bindtap="onSave"><text>保存</text></view>
  </view>
</view>
