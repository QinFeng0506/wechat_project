<!-- 服务项目编辑页 -->
<view class="page container">

  <!-- 基本信息 -->
  <view class="card form-card">
    <view class="form-row">
      <text class="form-label">项目名称</text>
      <input class="form-input" placeholder="如：纯色美甲" value="{{name}}" bindinput="onNameInput" maxlength="20" />
    </view>
    <view class="form-row">
      <text class="form-label">价格（元）</text>
      <input class="form-input" type="number" placeholder="如：128" value="{{price}}" bindinput="onPriceInput" />
    </view>
    <view class="form-row">
      <text class="form-label">时长（分钟）</text>
      <input class="form-input" type="number" placeholder="如：60" value="{{duration}}" bindinput="onDurationInput" />
    </view>
    <view class="form-row form-col no-border">
      <text class="form-label">项目介绍</text>
      <textarea class="form-textarea" placeholder="一句话介绍，如：进口环保甲油胶，饱满均匀色泽" value="{{desc}}" bindinput="onDescInput" maxlength="50" />
      <text class="text-xs text-muted text-right">{{desc.length}}/50</text>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-actions safe-bottom">
    <view class="btn-outline" bindtap="onCancel"><text>取消</text></view>
    <view class="btn-primary flex-1" bindtap="onSave"><text>保存</text></view>
  </view>
</view>
