<!-- 款式编辑页 — 新增/编辑表单 + 图片上传 -->
<view class="page container">

  <!-- 图片选择 -->
  <view class="image-section">
    <view class="image-picker" bindtap="onChooseImage">
      <image wx:if="{{coverImage}}" class="cover-preview" src="{{coverImage}}" mode="aspectFill" />
      <view wx:else class="image-placeholder">
        <text class="placeholder-icon">📷</text>
        <text class="text-xs text-muted">点击选择款式图片</text>
      </view>
      <view class="image-loading" wx:if="{{uploading}}">
        <text class="text-xs">图片处理中...</text>
      </view>
    </view>
    <text class="text-xs text-muted">点击图片从手机相册选择，自动压缩存储</text>
  </view>

  <!-- 基本信息 -->
  <view class="card form-card">
    <view class="form-row">
      <text class="form-label">款式名称</text>
      <input class="form-input" placeholder="如：法式渐变美甲" value="{{name}}" bindinput="onNameInput" maxlength="20" />
    </view>
    <view class="form-row">
      <text class="form-label">款式分类</text>
      <picker class="form-picker" range="{{subCategories}}" value="{{subCategoryIndex}}" bindchange="onPickSubCategory">
        <view class="picker-value">
          <text>{{subCategories[subCategoryIndex]}}</text>
          <text class="picker-arrow">▾</text>
        </view>
      </picker>
    </view>
    <view class="form-row">
      <text class="form-label">价格（元）</text>
      <input class="form-input" type="number" placeholder="如：238" value="{{price}}" bindinput="onPriceInput" />
    </view>
    <view class="form-row no-border">
      <text class="form-label">时长（分钟）</text>
      <input class="form-input" type="number" placeholder="如：90" value="{{duration}}" bindinput="onDurationInput" />
    </view>
  </view>

  <!-- 款式描述 -->
  <view class="card form-card">
    <view class="form-row form-col no-border">
      <text class="form-label">款式描述</text>
      <textarea class="form-textarea" placeholder="介绍款式的特点、适合场合等" value="{{description}}" bindinput="onDescInput" maxlength="200" />
      <text class="text-xs text-muted text-right">{{description.length}}/200</text>
    </view>
  </view>

  <!-- 展示标记 -->
  <view class="card form-card">
    <view class="form-row">
      <view class="flex-1">
        <text class="form-label">🔥 热门推荐</text>
        <text class="text-xs text-muted">显示在首页「热门推荐」区</text>
      </view>
      <switch checked="{{isHot}}" color="#D4A0A0" bindchange="onToggleHot" />
    </view>
    <view class="form-row no-border">
      <view class="flex-1">
        <text class="form-label">✨ 新品上架</text>
        <text class="text-xs text-muted">显示在首页「新品上架」区</text>
      </view>
      <switch checked="{{isNew}}" color="#D4A0A0" bindchange="onToggleNew" />
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-actions safe-bottom">
    <view class="btn-outline" bindtap="onCancel"><text>取消</text></view>
    <view class="btn-primary flex-1" bindtap="onSave"><text>保存</text></view>
  </view>
</view>
