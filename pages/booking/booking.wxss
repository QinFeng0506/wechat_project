/**
 * 在线预约页样式
 */

.page {
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* ===== 步骤指示器 ===== */
.steps-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-md);
  background: var(--bg-white);
  border-bottom: 1rpx solid var(--border);
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-round);
  background: var(--bg-muted);
  color: var(--text-muted);
  font-size: var(--font-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  margin-bottom: 6rpx;
  transition: all 0.3s;
}

.step-current .step-num {
  background: var(--primary);
  color: var(--text-white);
}

.step-done .step-num {
  background: var(--primary-light);
  color: var(--primary-dark);
}

.step-label {
  font-size: var(--font-xs);
  color: var(--text-muted);
}

.step-current .step-label {
  color: var(--primary);
  font-weight: 500;
}

.step-done .step-label {
  color: var(--primary-dark);
}

.step-line {
  width: 60rpx;
  height: 2rpx;
  background: var(--border);
  margin: 0 var(--spacing-sm);
  margin-bottom: 28rpx;
}

.line-done {
  background: var(--primary-light);
}

/* ===== Step 内容区 ===== */
.step-content {
  padding: var(--spacing-md);
}

.step-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: var(--spacing-sm);
}

/* ===== 项目选择 (Step 1) ===== */
.project-group {
  margin-bottom: var(--spacing-md);
}

.project-group-title {
  font-size: var(--font-md);
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: var(--spacing-sm);
}

.project-item {
  display: flex;
  align-items: center;
  background: var(--bg-white);
  border-radius: var(--radius-md);
  padding: var(--spacing-sm) var(--spacing-md);
  margin-bottom: var(--spacing-xs);
  border: 2rpx solid transparent;
  box-shadow: var(--shadow-card);
  transition: all 0.2s;
}

.project-selected {
  border-color: var(--primary);
  background: rgba(212, 160, 160, 0.04);
}

.project-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.project-name {
  font-size: var(--font-sm);
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 4rpx;
}

.project-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: var(--spacing-sm);
}

.project-price {
  font-size: var(--font-md);
}

.checkbox-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--radius-round);
  border: 2rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: var(--text-white);
  transition: all 0.2s;
}

.checkbox-icon.checked {
  background: var(--primary);
  border-color: var(--primary);
}

/* 已选摘要 */
.selected-summary {
  background: var(--bg-muted);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  margin-top: var(--spacing-sm);
}

.summary-title {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: var(--spacing-sm);
}

.summary-item {
  display: flex;
  justify-content: space-between;
  padding: 4rpx 0;
}

.summary-total {
  margin-top: var(--spacing-sm);
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid var(--border);
}

/* ===== 技师选择 (Step 2) ===== */
.tech-card {
  display: flex;
  align-items: center;
  background: var(--bg-white);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-sm);
  box-shadow: var(--shadow-card);
  border: 2rpx solid transparent;
  position: relative;
  transition: all 0.2s;
}

.tech-selected {
  border-color: var(--primary);
  background: rgba(212, 160, 160, 0.04);
}

.tech-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-round);
  margin-right: var(--spacing-md);
  flex-shrink: 0;
  background: var(--primary-light);
}

.tech-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.tech-name {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
  margin-right: var(--spacing-sm);
}

.tech-title {
  color: var(--primary);
  background: var(--primary-light);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-sm);
}

.tech-tags {
  margin: var(--spacing-xs) 0;
}

.tech-check {
  position: absolute;
  top: var(--spacing-sm);
  right: var(--spacing-sm);
  width: 44rpx;
  height: 44rpx;
  background: var(--primary);
  border-radius: var(--radius-round);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tech-check-icon {
  color: var(--text-white);
  font-size: var(--font-sm);
  font-weight: 700;
}

/* ===== 日期选择 (Step 3) ===== */
.date-scroll {
  white-space: nowrap;
  width: 100%;
  padding-bottom: var(--spacing-sm);
}

.date-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 28rpx;
  background: var(--bg-white);
  border-radius: var(--radius-md);
  margin-right: var(--spacing-sm);
  box-shadow: var(--shadow-card);
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.date-item:last-child {
  margin-right: 0;
}

.date-selected {
  border-color: var(--primary);
  background: rgba(212, 160, 160, 0.06);
}

.date-disabled {
  opacity: 0.35;
  pointer-events: none;
}

.date-week {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  margin-bottom: 4rpx;
}

.date-selected .date-week {
  color: var(--primary);
  font-weight: 500;
}

.date-num {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
}

.date-selected .date-num {
  color: var(--primary);
}

/* ===== 时段选择 ===== */
.time-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.time-slot {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 20rpx;
  background: var(--bg-white);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  font-size: var(--font-sm);
  color: var(--text-primary);
  border: 2rpx solid transparent;
  flex: 0 0 calc(25% - 12rpx);
  transition: all 0.2s;
}

.time-selected {
  border-color: var(--primary);
  background: rgba(212, 160, 160, 0.06);
  color: var(--primary);
  font-weight: 500;
}

.time-disabled {
  opacity: 0.35;
  pointer-events: none;
}

/* ===== 备注 ===== */
.remark-input {
  width: 100%;
  min-height: 140rpx;
  background: var(--bg-white);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  font-size: var(--font-sm);
  color: var(--text-primary);
  box-sizing: border-box;
  box-shadow: var(--shadow-card);
}

.remark-placeholder {
  color: var(--text-muted);
}

/* ===== 订单确认摘要 ===== */
.order-summary {
  padding: var(--spacing-md);
}

.order-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
}

.order-total {
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid var(--border);
}

/* ===== 底部操作栏 ===== */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-white);
  box-shadow: 0 -2rpx 20rpx rgba(180, 150, 150, 0.08);
  padding: var(--spacing-sm) var(--spacing-md);
  padding-bottom: calc(var(--spacing-sm) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--spacing-sm) + env(safe-area-inset-bottom));
  display: flex;
  gap: var(--spacing-sm);
  z-index: 100;
}

.bottom-action .btn-primary {
  height: 80rpx;
}
